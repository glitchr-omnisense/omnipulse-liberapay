{
    "name": "omnipulse/liberapay",
    "type": "library",
    "description": "Omnipulse's Liberapay, under any PHP host: an account's public profile read from Liberapay's public.json - patrons counted, weekly income, goal, summary (no key; Liberapay keeps patrons and tiers private).",
    "keywords": [
        "donations",
        "liberapay",
        "funding",
        "patrons",
        "framework-agnostic",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-liberapay",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnipulse": "^1.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "replace": {
        "omnifund/liberapay": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\Liberapay\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\Liberapay\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
